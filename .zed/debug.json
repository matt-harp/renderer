		"request": "launch",
		"stopAtEntry": false
	},
	{
		"adapter": "CodeLLDB",
		"label": "Debug Odin Executable linux",
		"program": "build/engine",
		"args": [],
		"cwd": "$ZED_WORKTREE_ROOT",
		"request": "launch",
		"stopAtEntry": false
	},
  {
    "adapter": "CodeLLDB",
